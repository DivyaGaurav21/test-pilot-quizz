PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/test-pilot
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
# Set to false to use the operating system DNS resolver instead of 8.8.8.8 / 1.1.1.1
ALLOW_CUSTOM_DNS=true
# Payment keys are unused until Phase 4. Do not put live credentials here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
